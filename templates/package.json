{
  "name": "@zerobias-org/framework-{vendor}-{suite}-{version}",
  "version": "1.0.0",
  "description": "{standardName}",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/framework.git",
    "directory": "package/{vendor}/{suite}/{version}/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../../scripts/correctDeps.ts",
    "validate": "tsx ../../../../scripts/validate.ts"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org/"
  },
  "files": [
    "index.yml",
    "baselines/**",
    "elements/**"
  ],
  "zerobias": {
    "dataloader-version": "1.0.0",
    "import-artifact": "framework",
    "package": "{vendor}.{suite}.{version}.framework",
    "orgId": "{target-org-uuid}"
  },
  "dependencies": {
    "@zerobias-org/suite-{vendor}-{suite}": "latest"
  }
}
