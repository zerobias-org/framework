{
  "name": "@zerobias-org/framework-{vendor}-{suite}-{version}",
  "version": "1.0.0-rc.0",
  "description": "{standardName}",
  "author": "team@zerobias.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/standard.git",
    "directory": "package/{vendor}/{suite}/{version}/"
  },
  "scripts": {
    "nx:publish": "{depthToScripts}scripts/publish.sh",
    "prepublishtest": "{depthToScripts}scripts/prepublish.sh",
    "correct:deps": "ts-node {depthToScripts}scripts/correctDeps.ts",
    "validate": "ts-node {depthToScripts}scripts/validate.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "index.yml"
  ],
  "auditmation": {
    "dataloader-version": "3.29.26",
    "import-artifact": "framework",
    "package": "{vendor}.{suite}.{version}.framework"
  },
  "dependencies": {
    "@auditlogic/vendor-zerobias": "latest"
  }
}
